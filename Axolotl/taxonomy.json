{
  "project_name": "Grounded NLP: Text-to-Action Sequence Generator",
  "version": "1.0.0",
  "description": "Single Source of Truth (SSoT) untuk taksonomi Intent, Slot, Grounding Rules, dan Batasan Kosakata bahasa Indonesia.",
  "intents": {
    "DIRECT_COMMAND": {
      "execution_type": "DIRECT",
      "description": "Perintah gerakan robot yang harus segera dieksekusi tanpa penundaan waktu.",
      "examples": [
        "maju dua meter",
        "putar ke kanan sembilan puluh derajat dengan cepat",
        "geser ke kiri 50 centimeter pelan-pelan"
      ]
    },
    "SCHEDULED_COMMAND": {
      "execution_type": "SCHEDULED",
      "description": "Perintah gerakan robot yang dijadwalkan untuk dieksekusi pada waktu spesifik di masa depan.",
      "examples": [
        "maju satu meter pukul tiga sore nanti",
        "besok jam 10 pagi putar balik",
        "tolong geser ke kanan 2 meter nanti malam pukul delapan"
      ]
    },
    "REPEATED_COMMAND": {
      "execution_type": "REPEATED",
      "description": "Perintah gerakan robot yang dieksekusi secara berkala (berulang) dengan interval tertentu.",
      "examples": [
        "putar ke kiri sepuluh derajat setiap lima detik",
        "maju setengah meter tiap jam",
        "lakukan pergerakan maju 2 langkah setiap 10 menit mulai jam 9 pagi"
      ]
    },
    "STOP_COMMAND": {
      "execution_type": "STOP",
      "description": "Perintah untuk menghentikan pergerakan aktif robot saat ini atau membatalkan seluruh jadwal antrean aksi.",
      "examples": [
        "berhenti sekarang",
        "setop robot",
        "batalkan semua jadwal",
        "diam di tempat"
      ]
    }
  },
  "slots": {
    "ACTION": {
      "tag_bio": ["B-ACTION", "I-ACTION"],
      "description": "Kata kerja utama yang merepresentasikan jenis pergerakan atau manipulasi fisik robot."
    },
    "DIRECTION": {
      "tag_bio": ["B-DIRECTION", "I-DIRECTION"],
      "description": "Arah relatif atau absolut dari pergerakan robot."
    },
    "QUANTITY": {
      "tag_bio": ["B-QUANTITY", "I-QUANTITY"],
      "description": "Besaran numerik atau kuantitatif dari gerakan, jarak, sudut, atau waktu."
    },
    "UNIT": {
      "tag_bio": ["B-UNIT", "I-UNIT"],
      "description": "Satuan ukuran dari kuantitas yang diberikan (panjang, sudut, frekuensi, atau waktu)."
    },
    "MODIFIER": {
      "tag_bio": ["B-MODIFIER", "I-MODIFIER"],
      "description": "Keterangan tambahan untuk memodifikasi cara kerja aksi (misalnya kecepatan atau tingkat kedaruratan)."
    },
    "TIME": {
      "tag_bio": ["B-TIME", "I-TIME"],
      "description": "Keterangan waktu spesifik atau relatif untuk eksekusi penjadwalan."
    },
    "DATE": {
      "tag_bio": ["B-DATE", "I-DATE"],
      "description": "Keterangan tanggal spesifik atau relatif untuk eksekusi penjadwalan."
    }
  },
